# Copy to .env for running the apps on the host (`pnpm dev`) and for Prisma CLI
# commands such as `pnpm db:migrate`, which read this file.
#
# Values point at localhost because Compose publishes each service's port.
# Inside Compose the apps get their own env with container hostnames
# (postgres, redis, minio) — see docker/compose.yaml.

NODE_ENV=development
LOG_LEVEL=debug
BASE_DOMAIN=localhost

DATABASE_URL=postgres://shipyard:shipyard@localhost:5432/shipyard
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=deployments
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
# MinIO and other S3-compatible stores need path-style URLs; real AWS S3 does not.
S3_FORCE_PATH_STYLE=true

# PORT is deliberately NOT set here. This one file is read by every service,
# so a single PORT would put the api and the router on the same socket under
# `pnpm dev`. Each service defaults itself in its own lib/clients.ts
# (api 4000, router 4001); Compose sets PORT per service instead.

# Worker: BUILDS_HOST_PATH must be the path as the Docker daemon sees it,
# because it bind-mounts this directory into each build container.
BUILDS_DIR=./data/builds
BUILDS_HOST_PATH=./data/builds
BUILD_CONCURRENCY=2
BUILD_TIMEOUT_MS=900000
